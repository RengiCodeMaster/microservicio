# Configuración del Microservicio de Depósito en Dólares
APP_NAME=usd-deposit-service
ENV=development
PORT=8000
LOG_LEVEL=INFO

# Base de Datos (PostgreSQL en Docker o SQLite para pruebas locales directas)
DATABASE_URL=sqlite+aiosqlite:///./deposits.db
# Para PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/deposits_db

# Microservicio de Cuentas (Remoto / Mock)
ACCOUNTS_SERVICE_URL=http://localhost:8081
ACCOUNTS_SERVICE_TIMEOUT_SEC=5.0

# Reglas de Negocio Financieras
DAILY_LIMIT_USD=20000.00
AML_THRESHOLD_USD=10000.00
MIN_DEPOSIT_USD=1.00
MAX_DIGITAL_DEPOSIT_USD=5000.00
MAX_BRANCH_DEPOSIT_USD=50000.00
